# PostgreSQL connection string used by Prisma and NestJS.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dheera_creatives_db?schema=public"

# Required only for `npm run db:seed`; never commit real values.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional. Admin session lifetime in hours (default 8).
SESSION_TTL_HOURS=8

# Optional. Comma-separated origins allowed to call the API with credentials.
# The admin dev server (Vite) defaults to http://localhost:5173.
ADMIN_FRONTEND_ORIGIN=http://localhost:5173

# Optional. Directory for uploaded product/service images (default: uploads).
# Must be writable and persist across restarts.
UPLOAD_DIR=uploads
