# Copy to .env and fill in real values. Never commit .env.
# Production values are shown in comments; the defaults here are for local
# development and tests.

# development | test | production
NODE_ENV=development

# Port NestJS listens on (default 3000). Keep it off the public interface:
# nginx proxies to it over loopback in the approved architecture.
PORT=3000

# PostgreSQL connection string used by Prisma and NestJS.
# Production: use a dedicated, non-superuser role and a private/loopback host.
# Add sslmode=require (or verify-full with a CA) when the database is remote.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dheera_creatives_db?schema=public"

# Required only for `npm run db:seed`; never commit real values.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional. Admin session lifetime in hours (default 8, max 720).
SESSION_TTL_HOURS=8

# Optional. Sign the admin out after this many minutes without activity
# (default 30). Must be shorter than SESSION_TTL_HOURS to matter.
SESSION_IDLE_TTL_MINUTES=30

# Comma-separated origins allowed to call the API with credentials and to send
# the login Origin header. Development default: http://localhost:5173.
# Production: https://dheera.digimaraa.in (https:// is required in production).
ADMIN_FRONTEND_ORIGIN=http://localhost:5173

# Optional. Directory for uploaded product/service images (default: uploads).
# Must be writable by the Node user and persist across restarts.
# Production example: UPLOAD_DIR=/var/lib/dheera/uploads
UPLOAD_DIR=uploads

# Required in production. Network interface to listen on. The development
# default is 0.0.0.0 (all interfaces). In production set 127.0.0.1 when nginx
# runs on the same machine, or the private interface address otherwise.
BIND_HOST=0.0.0.0

# Required in production. Number of reverse-proxy hops Express should trust, so
# the rate limiter and login protection see the real client IP. Use 0 when the
# app is reached directly, 1 behind a single nginx hop, 2 behind Cloudflare +
# nginx. Never use `true` in production: clients could spoof X-Forwarded-For.
TRUST_PROXY=0
