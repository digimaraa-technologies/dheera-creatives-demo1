# Copy to .env and fill in real values. Never commit .env.
# Production values are shown in comments/placeholders; defaults are for local
# development and tests.

# development | test | production
NODE_ENV=development

# Port the app listens on. Default 3000. Hostinger Web Apps provides PORT at runtime.
PORT=3000

# MariaDB/MySQL connection string used by Prisma and NestJS.
# Production (Hostinger managed MariaDB): use the provided host/port/user/password/database
# and required connection parameters (for example SSL) as documented by Hostinger.
# Never commit real credentials.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Required only for `npm run db:seed` or `npm run db:reset-admin`; never commit real values.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional. Admin session lifetime in hours (default 8, max 720).
SESSION_TTL_HOURS=8

# Optional. Sign the admin out after this many minutes without activity
# (default 30). Must be shorter than SESSION_TTL_HOURS to matter.
SESSION_IDLE_TTL_MINUTES=30

# Comma-separated origins allowed to call the API with credentials and to send
# the login Origin header. Development default: http://localhost:5173.
# Production: https://dheera.digimaraa.in (https:// is required in production).
ADMIN_FRONTEND_ORIGIN=http://localhost:5173

# Optional. Directory for uploaded product/service images (default: uploads).
# Local development: keep a writable local directory.
# Hostinger managed Web Apps do not provide verified persistent storage for
# app-directory uploads; production image uploads are disabled until durable
# storage is configured. Do not assume this path persists across deploys.
UPLOAD_DIR=uploads

# Required in production. Network interface to bind. Set explicitly for the
# runtime (for example 0.0.0.0 on managed Web Apps when required by the platform,
# or a specific interface as appropriate). Do not guess.
BIND_HOST=0.0.0.0

# Required in production. Number of reverse-proxy hops Express should trust, so
# rate limiting and login protection see the real client IP. Set to the actual hop
# count for the Hostinger/proxy topology (0 when reached directly). Never use
# `true` in production.
TRUST_PROXY=0
